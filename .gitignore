# =====================================================================
# .gitignore for the SEN3006 Gym Membership Management System
# =====================================================================
# Keep the repository clean: only source code, documentation, build
# scripts, and the packaged runnable artifacts are tracked.
# =====================================================================

# ---- Archived/historical work (kept locally, never published) -----
archive/

# ---- Compiled Java output ------------------------------------------
*.class
bin/
out/
build/
target/

# ---- Runtime-generated files --------------------------------------
audit.log

# ---- Archives ------------------------------------------------------
# Default: ignore every archive...
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ...except the runnable jar we ship.
!gym.jar
!SEN3006_Gym_Membership_Management_System.zip

# ---- IDE and editor settings ---------------------------------------
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.vscode/
*.code-workspace
nbproject/private/
*.bak
*.swp
*~

# ---- Bundled JDK / runtime downloads -------------------------------
# Some IDEs cache a full JDK inside the workspace; never publish it.
oracleJdk*/
**/oracleJdk*/
jdk-*/
jre-*/

# ---- Operating-system noise ----------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# ---- Environment, secrets, local config ----------------------------
.env
.env.*
env/
.venv/
secrets/
*.pem
*.key

# ---- Tooling-only directories (not part of the deliverable) --------
.claude/
.mcp.json
CLAUDE.md
.cursor/
.aider*
.gemini/
.copilot/
.continue/
docs/superpowers/
docs/design/project-options.md
generate-pdf-report.py

# ---- Generated diagram exports & temporary docs --------------------
docs/uml/exports/
*.pdf
*.html
!docs/report/*.html
!PRESENTATION.pdf
**/baseline-main-output.txt
**/test-output.txt

# ---- Logs and crash dumps ------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log

# ---- Package manager cruft (defensive) -----------------------------
node_modules/
.gradle/
.mvn/
