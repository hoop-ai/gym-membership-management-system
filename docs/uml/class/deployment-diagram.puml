@startuml GymManagementDeploymentDiagram
title Gym Membership Management System -- Deployment Diagram

node "User's computer" as PC {
    artifact "Operating System\n(Windows / macOS / Linux)" as OS

    node "Java Virtual Machine (JDK 8+)" as JVM {
        artifact "Main.class\n(scripted demo)"                  as MAIN
        artifact "GymManagementApp.class\n(console driver)"     as APP
        artifact "GymManagerGUI.class\n+ gui/*.class"           as GUI

        artifact "Gym.class\n+ MembershipPlan\n+ Member\n+ events\n+ notifiers\n+ enums" as ENG
    }
}

MAIN --> ENG
APP --> ENG
GUI --> ENG

note right of JVM
  Three optional entry points
  share one engine.
  No external services or
  network dependencies.
end note

@enduml
