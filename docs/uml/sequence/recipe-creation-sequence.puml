@startuml RecipeCreationSequence
title Recipe creation and ordering -- Sequence Diagram

actor User
participant "RecipeManager" as RM
participant "factoryRegistry\n: Map<String,\nRecipeFactory>" as Reg
participant "DessertRecipeFactory" as DF
participant "DessertRecipe" as DR
participant "currentStrategy\n: SortStrategy" as ST

== Create a recipe (Factory Method) ==

User -> RM : createRecipe("DESSERT", "Tiramisu", "...", 4)
RM -> Reg : get("DESSERT")
Reg --> RM : DessertRecipeFactory
RM -> DF : createRecipe("Tiramisu", "...", 4)
DF -> DR : new DessertRecipe(...)
DR --> DF : recipe
DF --> RM : Recipe
RM -> RM : recipes.add(recipe)
RM --> User : Recipe

== Order the recipe list (Strategy) ==

User -> RM : setSortStrategy(new DeadlineFirstStrategy())
User -> RM : getOrderedRecipes()
RM -> ST : sort(recipes)
ST --> RM : sorted copy
RM --> User : List<Recipe>

@enduml
