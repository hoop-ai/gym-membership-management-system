@startuml RecipeManagementDeploymentDiagram
title Recipe Management System -- Deployment Diagram

node "User's computer" as PC {
    artifact "Operating System\n(Windows / macOS / Linux)" as OS

    node "Java Virtual Machine (JDK 8+)" as JVM {
        artifact "Main.class\n(scripted demo)"                  as MAIN
        artifact "RecipeManagementApp.class\n(console driver)"  as APP
        artifact "RecipeManagerGUI.class\n+ gui/*.class"        as GUI

        artifact "RecipeManager.class\n+ factories\n+ strategies\n+ recipes\n+ RecipeStatus" as ENG
    }
}

MAIN --> ENG
APP --> ENG
GUI --> ENG

note right of JVM
  Three optional entry points
  share one engine.
  No external services or
  network dependencies.
end note

@enduml
