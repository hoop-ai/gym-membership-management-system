@startuml RecipeManagementComponentDiagram
title Recipe Management System -- Component Diagram

skinparam componentStyle rectangle

package "Presentation layer" {
    [Main\n(test demo)]                 as MAIN
    [RecipeManagementApp\n(console)]    as APP
    [RecipeManagerGUI\n(Swing GUI)]     as GUI
}

package "Coordination layer" {
    [RecipeManager] as MGR
}

package "Pattern layer" {
    [RecipeFactory\nhierarchy]  as FACT
    [SortStrategy\nhierarchy]   as STRAT
    [RecipeStatus\nstate machine] as STATE
}

package "Product layer" {
    [Recipe / AbstractRecipe\nand 3 concrete recipes] as PROD
}

MAIN  --> MGR
APP   --> MGR
GUI   --> MGR

MGR --> FACT
MGR --> STRAT
MGR --> STATE
MGR --> PROD

FACT --> PROD
STATE <-- PROD
STRAT --> PROD

@enduml
