@startuml PublishEventSequence
title Enrol Member In Class -- Sequence Diagram

skinparam sequenceMessageAlign center
skinparam shadowing false
autonumber

participant "Main"                                  as Main
participant "Gym"                                   as Gym
participant "FitnessClass\n(Yoga Flow)"             as Yoga
participant "ConsoleObserver"                       as Console
participant "AuditFileObserver"                     as Audit
participant "InMemoryJournalObserver"               as Journal

Main -> Gym : enrolMemberInClass(1, "yoga flow")
activate Gym

Gym -> Gym : getMember(1)
note right of Gym : returns Sarah Connor

Gym -> Gym : getFitnessClass("yoga flow")
note right of Gym : case-insensitive lookup\nreturns the "Yoga Flow" class

Gym -> Yoga : hasMember(sarah)
Yoga --> Gym : false

Gym -> Yoga : isFull()
Yoga --> Gym : false

Gym -> Yoga : addMember(sarah)
Yoga --> Gym : ok

Gym -> Gym : publish(new MemberEnrolledInClassEvent(sarah, yoga))
note over Gym, Journal
  Single publish() call fans out
  to every registered observer.
  This is the Observer pattern in action.
end note

Gym -> Console : onEvent(event)
note right of Console : prints "[HH:MM:SS] [MEMBER_ENROLLED] ..." to stdout
Console --> Gym

Gym -> Audit : onEvent(event)
note right of Audit : appends one line to audit.log
Audit --> Gym

Gym -> Journal : onEvent(event)
note right of Journal : stores event in in-memory list
Journal --> Gym

Gym --> Main : return
deactivate Gym

@enduml
