@startuml GymManagementComponentDiagram
title Gym Membership Management System -- Component Diagram

skinparam componentStyle rectangle

package "Presentation layer" {
    [Main\n(test demo)]                 as MAIN
    [GymManagementApp\n(console)]       as APP
    [GymManagerGUI\n(Swing GUI)]        as GUI
}

package "Coordination layer" {
    [Gym] as GYM
}

package "Pattern layer" {
    [MembershipPlan.Builder]                as B
    [GymEvent hierarchy\n(abstract + 4 events)] as EVT
    [MemberNotifier hierarchy\n(interface + 3 channels)] as NOT
    [MembershipStatus\nstate machine] as STATE
}

package "Domain layer" {
    [MembershipPlan]                                  as PLAN
    [Member]                                          as MEMBER
    [AccessTier]                                      as TIER
}

MAIN --> GYM
APP  --> GYM
GUI  --> GYM

GYM --> B
GYM --> EVT
GYM --> NOT
GYM --> PLAN
GYM --> MEMBER

B    --> PLAN
PLAN --> TIER
MEMBER --> PLAN
MEMBER --> STATE
MEMBER --> NOT
NOT --> EVT

@enduml
